generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int       @id @default(autoincrement())
  password  String
  email     String    @unique
  firstname String
  lastname  String
  phone     String    @unique
  role      UserRole  @default(BUYER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  username  String    @unique
  addresses Address[]
  bids      Bid[]
  products  Product[]
  avatarUrl       String?
  resetOtp        String?
  resetOtpExpires DateTime?
  wallet          Wallet[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @db.Timestamp(0)
  products    Product[]
}

model Address {
  id         Int       @id @default(autoincrement())
  label      String?
  street     String
  city       String?
  state      String?
  postalCode String
  country    String
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt @db.Timestamp(0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  auctions   Auction[]

  @@index([userId], map: "Address_userId_fkey")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @db.Timestamp(0)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  Int?
  sellers     User?     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId    Int?
  auctions    Auction[]
  images      Image[]

  @@index([categoryId], map: "Product_categoryId_fkey")
  @@index([sellerId], map: "Product_sellerId_fkey")
}

model Image {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "Image_productId_fkey")
}

model Auction {
  id                Int           @id @default(autoincrement())
  productId         Int
  startTime         DateTime
  endTime           DateTime
  startingPrice     Decimal       @db.Decimal(10, 2)
  reservePrice      Decimal?      @db.Decimal(10, 2)
  minIncrement      Decimal       @db.Decimal(10, 2)
  status            AuctionStatus @default(WAITING)
  type              AuctionType   @default(ENGLISH)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt @db.Timestamp(0)
  product           Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  shippingAddress   Address?      @relation(fields: [shippingAddressId], references: [id], onDelete: Cascade)
  shippingAddressId Int?
  bids              Bid[]
  payments          Payment[]

  // Makes Start Cron fast: Checks status first, then finds the start time
  @@index([status, startTime])
  // Makes End Cron fast: Checks status first, then finds the end time
  @@index([status, endTime])
  @@index([productId], map: "Auction_productId_fkey")
  @@index([shippingAddressId], map: "Auction_shippingAddressId_fkey")
}

model Bid {
  id        String   @id @default(cuid())
  bidderId  Int
  auctionId Int?
  amount    Decimal  @db.Decimal(10, 2)
  isWinning Boolean  @default(false)
  createdAt DateTime @default(now())
  auction   Auction? @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder    User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)

   // for faster read on joins, but eats storage
  @@index([auctionId])
  @@index([bidderId])
}

model Payment {
  id               String        @id @default(cuid())
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @db.Char(3)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  gatewayReference String?       @unique
  gatewayResponse  Json?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt @db.Timestamp(0)
  auction          Auction?      @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId        Int?

  @@index([auctionId], map: "Payment_auctionId_fkey")
}

enum AuctionStatus {
  WAITING
  ACTIVE
  CANCELLED
  CLOSED
  UNSOLD
  SOLD
}

enum UserRole {
  BUYER
  SELLER
}

enum AuctionType {
  ENGLISH
  REVERSE
  SEALED_REVERSE
  SEALED_ENGLISH
  // SEALED_VICKREY
  // DUTCH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  PROMPTPAY
  CASH_ON_DELIVERY
  WALLET
}
model Wallet {
  id      String @id @default(cuid())
  amount  Int    @default(0) // This is the "Cache" of the total
  userId  Int    @unique
  user    User   @relation(fields: [userId], references: [id])
}

model Transaction {
  id        Int      @id @default(autoincrement())
  walletId  String
  amount    Int      // Positive for deposit, negative for spend
  type      String   // "DEPOSIT", "BID_PAYMENT", "WITHDRAWAL"
  createdAt DateTime @default(now())
}

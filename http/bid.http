@BASE_URL = http://localhost:3000/api
@ACCESS_TOKEN = {{login.response.body.token}}

### Login
# @name login
POST {{BASE_URL}}/auth/login HTTP/1.1
content-type: application/json

{
 "email" : "hellokitty@gmail.com",
 "password" : "99999"
}


###  Create bid
POST  {{BASE_URL}}/bids
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

{
  "bidderId": 1000,
  "auctionId": 7, 
  "amount": 2000
}

###  get all bids
GET  {{BASE_URL}}/bids
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

###  get bid by id
GET  {{BASE_URL}}/bids/cmo2quvvz0000muyzswdp4eh3
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

###  DELETE bid by id
DELETE  {{BASE_URL}}/bids/cmo2r3yls0001muyzlgxs5mke
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

###  Update bid status
POST  {{BASE_URL}}/bids
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

{
    "isWinning": true
} 

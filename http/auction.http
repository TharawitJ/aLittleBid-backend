###  Create auction
POST  {{BASE_URL}}/auctions
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "productId": 108,
  "startTime": "2026-04-17T10:04:24.997Z",
  "endTime": "2026-06-09T06:13:00.000Z",
  "startingPrice": 1,
  "reservePrice": 15000,
  "minIncrement": 1000,
  "status": "WAITING"
}

###  get all auctions
GET  {{BASE_URL}}/auctions
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}  

###  get auction by id
GET  {{BASE_URL}}/auctions/10
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}  

###  DELETE auction by id
DELETE  {{BASE_URL}}/auctions/10
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}  

###  Update auction
PATCH  {{BASE_URL}}/auctions/10
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}  

{
  "startTime": "2026-06-06T06:13:00.000Z",
  "endTime": "2026-06-09T06:13:00.000Z",
  "startingPrice": 1000,
  "reservePrice": 5500,
  "minIncrement": 200,
  "status": "WAITING"
}
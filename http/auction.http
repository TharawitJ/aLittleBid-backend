###  get all auction
GET  {{BASE_URL}}/auctions
content-type: application/json
Authorization: Bearer 

###  get auction by id
GET  {{BASE_URL}}/auctions/4
content-type: application/json
Authorization: Bearer 

###  DELETE auction by id
DELETE  {{BASE_URL}}/auctions/3
content-type: application/json
Authorization: Bearer 

###  Create auction
POST  {{BASE_URL}}/auctions
content-type: application/json
Authorization: Bearer 

{
  "productId": 55,
  "startTime": "2026-06-06T06:13:00.000Z",
  "endTime": "2026-06-09T06:13:00.000Z",
  "startingPrice": 1,
  "reservePrice": 1000,
  "minIncrement": 100,
  "status": "WAITING"
} 

###  Update auction
PATCH  {{BASE_URL}}/auctions/4
content-type: application/json
Authorization: Bearer 

{
  "startTime": "2026-06-06T06:13:00.000Z",
  "endTime": "2026-06-09T06:13:00.000Z",
  "startingPrice": 1,
  "reservePrice": 5500,
  "minIncrement": 200,
  "status": "ACTIVE"
}


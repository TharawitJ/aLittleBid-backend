@BASE_URL = http://localhost:3000/api
@ACCESS_TOKEN = {{login.response.body.token}}

### Login
# @name login
POST {{BASE_URL}}/auth/login HTTP/1.1
content-type: application/json

{
 "email" : "milk@gmail.com",
 "password" : "11111111"
}

###  Create product
POST  {{BASE_URL}}/products
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
   "name": "final", 
   "description": "front end hoho", 
   "categoryId": 1
}


###  Update product data
PATCH  {{BASE_URL}}/products/113
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

{
   "name": "Best coffee mug", 
   "description": "the ultimate designer mug", 
   "categoryId": 16
}

###  Get product by id
GET  {{BASE_URL}}/products/133
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

###  Get all products
GET  {{BASE_URL}}/products?auctionStatus=ACTIVE
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 


###  Delete product by Id
DELETE  {{BASE_URL}}/products/108
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

### ### ### ### ### ###  CATEGORY HTTP ### ### ### 

###  Get all categories
GET  {{BASE_URL}}/products/categories
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 


### ### ### ### ### ###  IMAGE HTTP ### ### ### 

###  Create image
POST  {{BASE_URL}}/products/images
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
   "productId": 36, 
   "imageUrl": "https://picsum.photos/seed/picsum/200/300"
}

###  Get all images
GET  {{BASE_URL}}/products/images
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

###  Get image by id
GET  {{BASE_URL}}/products/images/201
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

###  Delete product by Id
DELETE  {{BASE_URL}}/products/images/202
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 
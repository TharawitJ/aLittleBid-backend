@BASE_URL = http://localhost:3000/api
@ACCESS_TOKEN = {{login.response.body.token}}

### Login
# @name login
POST {{BASE_URL}}/auth/login HTTP/1.1
content-type: application/json

{
 "email" : "fruity5@gmail.com",
 "password" : "loml555"
}

###  Create product
POST  {{BASE_URL}}/products
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
   "name": "holy water", 
   "description": "long live", 
   "categoryId": 13
}


###  Update product data
PATCH  {{BASE_URL}}/products/108
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

{
   "name": "Best coffee mug", 
   "description": "the ultimate designer mug", 
   "categoryId": 16
}

###  Get product by id
GET  {{BASE_URL}}/products/56
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

###  Get all products
GET  {{BASE_URL}}/products
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 


###  Delete product by Id
DELETE  {{BASE_URL}}/products/108
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 

###  Get all categories
GET  {{BASE_URL}}/products/categories
content-type: application/json
Authorization: Bearer {{ACCESS_TOKEN}} 